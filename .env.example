# VIKO Assistant — environment configuration
# Copy to .env and fill in. .env is gitignored; never commit real keys.

# ── Required ────────────────────────────────────────────────────────────────
# Gemini Live API key — powers the voice agent. https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ── LLM for code generation (optional) ──────────────────────────────────────
# If set, self-engineer / dev_agent / code_helper route to Claude Sonnet.
# If empty, they fall back to Gemini. (See viko/self_engineer/llm.py)
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# ── Voice ───────────────────────────────────────────────────────────────────
# Gemini Live prebuilt voice name. Auditioned female voices (id-ID), by character:
#   Erinome (clear)  ·  Despina (smooth/sultry)  ·  Algieba (smooth)  ·  Achernar (soft)
#   Vindemiatrix (gentle)  ·  Sulafat (warm)  ·  Aoede (warm/breezy)  ·  Leda (youthful)
#   Also female: Zephyr (bright), Callirrhoe (easy-going).   Male: Puck, Charon, Fenrir, Orus
# Default: Aoede
VIKO_VOICE=Aoede
# TTS pronunciation language (BCP-47). Only honored by half-cascade Live models
# (gemini-3.x-*-live); native-audio models auto-detect and ignore this.
# Default: id-ID (Indonesian)
VIKO_VOICE_LANG=id-ID

# ── System ──────────────────────────────────────────────────────────────────
OS_SYSTEM=mac          # mac | windows | linux
CAMERA_INDEX=0         # webcam index for vision

# Typed passphrase that toggles a 5-minute speaker-verification bypass.
# Leave empty to disable the bypass entirely.
OWNER_PASSPHRASE=

# ── Location (for weather / HUD) ────────────────────────────────────────────
LATITUDE=
LONGITUDE=

# ── Offline LLM (Ollama) ────────────────────────────────────────────────────
# Local LLM used when Gemini Live drops. Requires Ollama running on localhost:11434.
# Install: open /Applications/Ollama.app — or https://ollama.com
# Models stored in models/ollama/ (gitignored). Pull: ollama pull qwen2.5:1.5b
# scripts/start.sh starts Ollama automatically if installed.
OLLAMA_MODEL=qwen2.5:1.5b

# ── Advanced (sensible defaults; usually leave unset) ───────────────────────
VIKO_CDP_PORT=9222              # Chromium remote-debug port for the browser panel
VIKO_MEMORY_RETENTION_DAYS=365  # how long long-term memories are kept
